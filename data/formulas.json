{
  "title": "Шпаргалка: электричество",
  "subtitle": "Все формулы курса в одном месте",
  "groups": [
    {
      "title": "Электростатика",
      "items": [
        {
          "name": "Квантование заряда",
          "expr": "q = N·e",
          "note": "e = 1,6·10[sup]−19[/sup] Кл"
        },
        {
          "name": "Закон Кулона",
          "expr": "F = k·|q[sub]1[/sub]q[sub]2[/sub]|/r[sup]2[/sup]",
          "note": "k = 9·10[sup]9[/sup] Н·м[sup]2[/sup]/Кл[sup]2[/sup]"
        },
        {
          "name": "Закон Кулона в среде",
          "expr": "F = k·|q[sub]1[/sub]q[sub]2[/sub]|/(ε·r[sup]2[/sup])",
          "note": "ε — диэлектрическая проницаемость"
        },
        {
          "name": "Напряжённость",
          "expr": "E = F/q[sub]0[/sub]",
          "note": "1 Н/Кл = 1 В/м"
        },
        {
          "name": "Поле точечного заряда",
          "expr": "E = k·|q|/(ε·r[sup]2[/sup])",
          "note": "от плюса, к минусу"
        },
        {
          "name": "Сила в поле",
          "expr": "F = q·E",
          "note": "направление зависит от знака заряда"
        },
        {
          "name": "Потенциал",
          "expr": "φ = k·q/(ε·r)",
          "note": "φ = 0 на бесконечности"
        },
        {
          "name": "Напряжение",
          "expr": "U = φ[sub]1[/sub] − φ[sub]2[/sub]",
          "note": "разность потенциалов"
        },
        {
          "name": "Работа поля",
          "expr": "A = q·U",
          "note": "не зависит от траектории"
        },
        {
          "name": "Однородное поле",
          "expr": "E = U/d",
          "note": "d — вдоль линии поля"
        }
      ]
    },
    {
      "title": "Конденсаторы",
      "items": [
        {
          "name": "Электроёмкость",
          "expr": "C = q/U",
          "note": "1 Ф = 1 Кл/В"
        },
        {
          "name": "Плоский конденсатор",
          "expr": "C = ε[sub]0[/sub]·ε·S/d",
          "note": "ε[sub]0[/sub] = 8,85·10[sup]−12[/sup] Ф/м"
        },
        {
          "name": "Энергия",
          "expr": "W = C·U[sup]2[/sup]/2",
          "note": "W = qU/2 = q[sup]2[/sup]/(2C)"
        },
        {
          "name": "Последовательно",
          "expr": "1/C = 1/C[sub]1[/sub] + 1/C[sub]2[/sub]",
          "note": "заряды одинаковы"
        },
        {
          "name": "Параллельно",
          "expr": "C = C[sub]1[/sub] + C[sub]2[/sub]",
          "note": "напряжения одинаковы"
        }
      ]
    },
    {
      "title": "Постоянный ток",
      "items": [
        {
          "name": "Сила тока",
          "expr": "I = q/t",
          "note": "1 А = 1 Кл/с"
        },
        {
          "name": "Сопротивление проводника",
          "expr": "R = ρ·l/S",
          "note": "S — в м[sup]2[/sup]"
        },
        {
          "name": "Нагрев металла",
          "expr": "R = R[sub]0[/sub]·(1 + α·Δt)",
          "note": "R растёт с температурой"
        },
        {
          "name": "Закон Ома",
          "expr": "I = U/R",
          "note": "для участка цепи"
        },
        {
          "name": "Последовательное соединение",
          "expr": "R = R[sub]1[/sub] + R[sub]2[/sub]",
          "note": "ток одинаков"
        },
        {
          "name": "Параллельное соединение",
          "expr": "1/R = 1/R[sub]1[/sub] + 1/R[sub]2[/sub]",
          "note": "напряжение одинаково"
        },
        {
          "name": "Делитель напряжения",
          "expr": "U[sub]1[/sub] = U·R[sub]1[/sub]/(R[sub]1[/sub] + R[sub]2[/sub])",
          "note": "последовательное соединение"
        },
        {
          "name": "Работа тока",
          "expr": "A = U·I·t",
          "note": "A = q·U"
        },
        {
          "name": "Мощность",
          "expr": "P = U·I",
          "note": "P = I[sup]2[/sup]R = U[sup]2[/sup]/R"
        },
        {
          "name": "Закон Джоуля—Ленца",
          "expr": "Q = I[sup]2[/sup]·R·t",
          "note": "теплота в проводнике"
        },
        {
          "name": "Киловатт-час",
          "expr": "1 кВт·ч = 3,6·10[sup]6[/sup] Дж",
          "note": "бытовая единица энергии"
        }
      ]
    },
    {
      "title": "Полная цепь",
      "items": [
        {
          "name": "Закон Ома для полной цепи",
          "expr": "I = ε/(R + r)",
          "note": "r — внутреннее сопротивление"
        },
        {
          "name": "Напряжение на клеммах",
          "expr": "U = ε − I·r",
          "note": "U = I·R"
        },
        {
          "name": "КПД источника",
          "expr": "η = U/ε = R/(R + r)",
          "note": "в долях или процентах"
        },
        {
          "name": "Максимальная мощность",
          "expr": "P[sub]max[/sub] = ε[sup]2[/sup]/(4r)",
          "note": "при R = r, КПД 50 %"
        }
      ]
    },
    {
      "title": "Ток в средах",
      "items": [
        {
          "name": "Закон Фарадея",
          "expr": "m = k·I·t",
          "note": "k — электрохимический эквивалент"
        },
        {
          "name": "Электрохимический эквивалент",
          "expr": "k = M/(n·F)",
          "note": "F = 96 485 Кл/моль"
        }
      ]
    }
  ]
}
